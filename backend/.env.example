# Application
APP_NAME=API
APP_VERSION=0.0.1
DEFAULT_TIMEZONE=UTC
SEARCH_TIMEOUT_SECONDS=10
SEARCH_AUDIT_RETENTION_DAYS=30
# Optional AI interpreter. Leave empty to keep AUTO mode on text search.
SEARCH_AI_PROVIDER=
SEARCH_AI_API_KEY=
SEARCH_AI_MODEL=
SEARCH_AI_BASE_URL=https://api.openai.com/v1
SEARCH_AI_TIMEOUT_SECONDS=10

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# Logging
LOG_LEVEL=INFO

# Security / JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ABSOLUTE_EXPIRE_DAYS=30
USER_LOG_STALE_TIMEOUT_SECONDS=300
USER_LOG_SWEEP_INTERVAL_SECONDS=60
JWT_ISSUER=webapp-api
JWT_AUDIENCE=webapp-client
REFRESH_COOKIE_NAME=refresh_token
REFRESH_CSRF_COOKIE_NAME=refresh_csrf
REFRESH_CSRF_HEADER_NAME=X-CSRF-Token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/graphql

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET", "POST", "OPTIONS"]
CORS_HEADERS=["Authorization", "Content-Type", "X-CSRF-Token"]

# Local attachment filestore
FILESTORE_ROOT=data/filestore
# Defaults to the database name when empty.
FILESTORE_NAMESPACE=
ATTACHMENT_MAX_SIZE_BYTES=26214400

# Web Push (browser notifications while the app is closed)
# Generate a pair with: python -m app.core.push.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
